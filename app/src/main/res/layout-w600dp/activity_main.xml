<?xml version="1.0" encoding="utf-8"?>
<!--
  宽度 ≥ 600dp（横屏手机、折叠屏展开、平板）：左侧导航栏替代底部导航，
  标题 / 项目切换 / 搜索合并为一行以节省高度；内容列的居中限宽由 MainActivity 按实际宽度计算。
  与 layout/activity_main.xml 使用相同的 id 和控件类型，ViewBinding 共用同一个绑定类。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 左侧导航栏 -->
        <LinearLayout
            android:id="@+id/navigation"
            android:layout_width="88dp"
            android:layout_height="0dp"
            android:background="@color/panel"
            android:baselineAligned="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <include
                android:id="@+id/nav_entries"
                layout="@layout/item_nav"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginBottom="4dp"
                android:layout_weight="0" />

            <include
                android:id="@+id/nav_todos"
                layout="@layout/item_nav"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginBottom="4dp"
                android:layout_weight="0" />

            <include
                android:id="@+id/nav_settings"
                layout="@layout/item_nav"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_weight="0" />
        </LinearLayout>

        <View
            android:id="@+id/nav_divider"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:background="@color/border"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/navigation"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 顶部：标题、项目切换、搜索同一行；搜索框随可用宽度收缩，最宽 360dp -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:background="@color/panel"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/nav_divider"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/title"
                style="@style/DvText.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/project"
                style="@style/DvText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/choose_project"
                android:drawableEnd="@drawable/ic_down_small"
                android:drawablePadding="2dp"
                android:drawableTint="@color/muted"
                android:ellipsize="end"
                android:maxWidth="200dp"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp"
                android:textColor="@color/muted"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/title"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/search"
                style="@style/DvInput"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_search"
                android:drawableStart="@drawable/ic_search_small"
                android:drawablePadding="8dp"
                android:drawableTint="@color/muted"
                android:hint="@string/search_entries_hint"
                android:imeOptions="actionSearch"
                android:paddingStart="12dp"
                android:paddingTop="0dp"
                android:paddingEnd="12dp"
                android:paddingBottom="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintStart_toEndOf="@id/project"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="360dp" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/header_divider"
            style="@style/DvDivider"
            android:layout_width="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/nav_divider"
            app:layout_constraintTop_toBottomOf="@id/header" />

        <!-- 账号类型筛选；左右留白随内容列宽度调整 -->
        <HorizontalScrollView
            android:id="@+id/filter_scroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/nav_divider"
            app:layout_constraintTop_toBottomOf="@id/header_divider">

            <LinearLayout
                android:id="@+id/filters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="96dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/nav_divider"
            app:layout_constraintTop_toBottomOf="@id/filter_scroll" />

        <TextView
            android:id="@+id/add"
            style="@style/DvText.Medium"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_margin="24dp"
            android:background="@drawable/bg_fab"
            android:drawableStart="@drawable/ic_plus_small"
            android:drawablePadding="6dp"
            android:drawableTint="@android:color/white"
            android:elevation="6dp"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="20dp"
            android:text="@string/new_entry"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 应用锁 -->
    <LinearLayout
        android:id="@+id/lock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_brand"
            android:importantForAccessibility="no"
            android:padding="14dp"
            android:src="@drawable/ic_lock"
            app:tint="@android:color/white" />

        <TextView
            style="@style/DvText.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/locked_title"
            android:textSize="22sp" />

        <TextView
            style="@style/DvText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/locked_desc"
            android:textColor="@color/muted" />

        <Button
            android:id="@+id/unlock"
            style="@style/DvButton.Primary"
            android:layout_width="160dp"
            android:layout_marginTop="24dp"
            android:text="@string/unlock" />
    </LinearLayout>
</FrameLayout>
