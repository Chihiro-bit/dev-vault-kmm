<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面：标题与项目切换、搜索、筛选、列表、新建按钮、底部导航；锁定时覆盖锁屏 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 顶部：标题 + 项目切换 + 搜索 -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/panel"
            android:orientation="vertical"
            android:paddingTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/title"
                style="@style/DvText.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/project"
                style="@style/DvText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/choose_project"
                android:drawableEnd="@drawable/ic_down_small"
                android:drawablePadding="2dp"
                android:drawableTint="@color/muted"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/search"
                style="@style/DvInput"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_search"
                android:drawableStart="@drawable/ic_search_small"
                android:drawablePadding="8dp"
                android:drawableTint="@color/muted"
                android:hint="@string/search_entries_hint"
                android:imeOptions="actionSearch"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp" />
        </LinearLayout>

        <View
            android:id="@+id/header_divider"
            style="@style/DvDivider"
            android:layout_width="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header" />

        <!-- 账号类型筛选 -->
        <HorizontalScrollView
            android:id="@+id/filter_scroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header_divider">

            <LinearLayout
                android:id="@+id/filters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="96dp"
            app:layout_constraintBottom_toTopOf="@id/nav_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/filter_scroll" />

        <TextView
            android:id="@+id/add"
            style="@style/DvText.Medium"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:background="@drawable/bg_fab"
            android:drawableStart="@drawable/ic_plus_small"
            android:drawablePadding="6dp"
            android:drawableTint="@android:color/white"
            android:elevation="6dp"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="20dp"
            android:text="@string/new_entry"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            app:layout_constraintBottom_toTopOf="@id/nav_divider"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/nav_divider"
            style="@style/DvDivider"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@id/navigation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 底部导航 -->
        <LinearLayout
            android:id="@+id/navigation"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:background="@color/panel"
            android:baselineAligned="false"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <include
                android:id="@+id/nav_entries"
                layout="@layout/item_nav"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <include
                android:id="@+id/nav_todos"
                layout="@layout/item_nav"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <include
                android:id="@+id/nav_settings"
                layout="@layout/item_nav"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 应用锁 -->
    <LinearLayout
        android:id="@+id/lock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_brand"
            android:importantForAccessibility="no"
            android:padding="14dp"
            android:src="@drawable/ic_lock"
            app:tint="@android:color/white" />

        <TextView
            style="@style/DvText.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/locked_title"
            android:textSize="22sp" />

        <TextView
            style="@style/DvText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/locked_desc"
            android:textColor="@color/muted" />

        <Button
            android:id="@+id/unlock"
            style="@style/DvButton.Primary"
            android:layout_width="160dp"
            android:layout_marginTop="24dp"
            android:text="@string/unlock" />
    </LinearLayout>
</FrameLayout>
