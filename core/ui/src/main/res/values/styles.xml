<?xml version="1.0" encoding="utf-8"?>
<!-- 与桌面端 styles.css 对应的控件样式；各功能模块的布局直接引用 -->
<resources>

    <!-- 文字 -->
    <style name="DvText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="DvText.Medium">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="DvText.Title">
        <item name="android:textSize">15sp</item>
    </style>
    <style name="DvText.Title.Bold">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="DvText.Heading">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <!-- 设置页分组标题 -->
    <style name="DvText.Section">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
    <!-- 表单字段名 -->
    <style name="DvText.Label">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text2</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
    <style name="DvText.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>
    <style name="DvText.Hint">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="DvText.Error">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/danger</item>
    </style>
    <style name="DvText.Mono">
        <item name="android:fontFamily">monospace</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- 输入框 -->
    <style name="DvInput">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:inputType">text</item>
        <item name="android:maxLines">1</item>
        <item name="android:saveEnabled">false</item>
        <item name="android:importantForAutofill">noExcludeDescendants</item>
    </style>
    <!-- 表单中的输入框：与下一个字段名保持间距 -->
    <style name="DvInput.Field">
        <item name="android:layout_marginBottom">14dp</item>
    </style>
    <style name="DvInput.Field.Password">
        <item name="android:inputType">textPassword</item>
    </style>
    <style name="DvInput.Field.Multiline">
        <item name="android:inputType">textMultiLine</item>
        <item name="android:maxLines">12</item>
        <item name="android:minLines">3</item>
        <item name="android:gravity">top|start</item>
    </style>

    <!-- 按钮 -->
    <style name="DvButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:layout_height">42dp</item>
    </style>
    <style name="DvButton.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/text_on_primary</item>
    </style>
    <style name="DvButton.Small">
        <item name="android:textSize">13sp</item>
        <item name="android:layout_height">32dp</item>
    </style>
    <style name="DvButton.Small.Danger">
        <item name="android:textColor">@color/danger</item>
    </style>
    <style name="DvButton.Danger">
        <item name="android:textColor">@color/danger</item>
    </style>
    <!-- 下拉选择：左对齐 + 末尾箭头 -->
    <style name="DvButton.Select">
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:drawableEnd">@drawable/ic_down_small</item>
        <item name="android:drawableTint">@color/muted</item>
        <item name="android:drawablePadding">6dp</item>
    </style>
    <style name="DvButton.Select.Small">
        <item name="android:textSize">13sp</item>
        <item name="android:layout_height">32dp</item>
    </style>
    <!-- 日期等选择按钮 -->
    <style name="DvButton.Picker">
        <item name="android:layout_height">38dp</item>
    </style>
    <!-- 正文中的文字链接 -->
    <style name="DvLink" parent="DvText">
        <item name="android:textColor">@color/primary</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="DvIconButton">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="tint">@color/muted</item>
    </style>
    <!-- 账号卡片字段行内的小图标按钮 -->
    <style name="DvIconButton.Small">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:padding">7.5dp</item>
    </style>

    <!-- 容器 -->
    <style name="DvCard">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:elevation">1dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">14dp</item>
    </style>
    <!-- 设置页卡片 -->
    <style name="DvCard.Settings">
        <item name="android:padding">16dp</item>
    </style>
    <!-- 内部带分隔线的列表卡片 -->
    <style name="DvCard.List">
        <item name="android:padding">0dp</item>
        <item name="android:divider">@drawable/divider</item>
        <item name="android:showDividers">middle</item>
    </style>
    <!-- 待办详情页中的整宽分区 -->
    <style name="DvPanelSection">
        <item name="android:background">@color/panel</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>
    <style name="DvDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/border</item>
    </style>

    <style name="DvSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="colorControlActivated">@color/primary</item>
    </style>
</resources>
