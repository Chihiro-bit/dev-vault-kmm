<?xml version="1.0" encoding="utf-8"?>
<!-- 未登录时设置页内嵌的登录 / 注册表单 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_icon_circle"
            android:importantForAccessibility="no"
            android:padding="11dp"
            android:src="@drawable/ic_cloud"
            app:tint="@color/muted" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/DvText.Title.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_local_mode" />

            <TextView
                style="@style/DvText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_local_desc" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal" />

    <TextView
        style="@style/DvText.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_server" />

    <EditText
        android:id="@+id/server"
        style="@style/DvInput.Field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/settings_server_hint"
        android:inputType="textUri" />

    <TextView
        style="@style/DvText.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_username" />

    <EditText
        android:id="@+id/username"
        style="@style/DvInput.Field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/settings_username_hint" />

    <LinearLayout
        android:id="@+id/name_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/DvText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@id/nickname"
            android:text="@string/settings_nickname" />

        <EditText
            android:id="@+id/nickname"
            style="@style/DvInput.Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        style="@style/DvText.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@id/password"
        android:text="@string/settings_master_password" />

    <EditText
        android:id="@+id/password"
        style="@style/DvInput.Field.Password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/confirm_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/DvText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@id/confirm"
            android:text="@string/settings_confirm_password" />

        <EditText
            android:id="@+id/confirm"
            style="@style/DvInput.Field.Password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/error"
        style="@style/DvText.Error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/submit"
        style="@style/DvButton.Primary"
        android:layout_width="match_parent"
        android:enabled="false"
        android:text="@string/settings_login" />

    <TextView
        style="@style/DvText.Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/settings_e2ee_hint" />
</LinearLayout>
