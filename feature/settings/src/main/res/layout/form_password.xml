<?xml version="1.0" encoding="utf-8"?>
<!-- 修改主密码弹窗 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/DvCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        style="@style/DvText.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@id/current"
        android:text="@string/settings_current_password" />

    <EditText
        android:id="@+id/current"
        style="@style/DvInput.Field.Password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        style="@style/DvText.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@id/next"
        android:text="@string/settings_new_password" />

    <EditText
        android:id="@+id/next"
        style="@style/DvInput.Field.Password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        style="@style/DvText.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@id/confirm"
        android:text="@string/settings_confirm_new_password" />

    <EditText
        android:id="@+id/confirm"
        style="@style/DvInput.Field.Password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/submit"
        style="@style/DvButton.Primary"
        android:layout_width="match_parent"
        android:text="@string/settings_change_password" />
</LinearLayout>
