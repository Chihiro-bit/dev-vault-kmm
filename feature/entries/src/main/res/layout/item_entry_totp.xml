<?xml version="1.0" encoding="utf-8"?>
<!-- TOTP 动态码行：每秒刷新验证码与剩余秒数 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="3dp"
    android:background="@drawable/bg_field_row"
    android:gravity="center_vertical"
    android:minHeight="38dp"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="0dp">

    <TextView
        style="@style/DvText"
        android:layout_width="84dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:text="@string/entry_totp"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/totp_code"
        style="@style/DvText.Mono"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:letterSpacing="0.1"
        android:textColor="@color/primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/totp_ring"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="20dp"
        android:layout_height="4dp"
        android:layout_marginEnd="5dp"
        android:progressTint="@color/primary" />

    <TextView
        android:id="@+id/totp_remaining"
        style="@style/DvText.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp" />

    <ImageButton
        android:id="@+id/totp_copy"
        style="@style/DvIconButton.Small"
        android:contentDescription="@string/entry_copy_totp"
        android:src="@drawable/ic_copy" />
</LinearLayout>
